# ---- Backend (backend/.env or Railway variables) --------------------------------
# Default is a local SQLite file. Production: Neon / Railway Postgres (postgres:// URLs are accepted).
# DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/signal?sslmode=require
# CORS_ORIGINS=https://your-app.vercel.app
# AUTO_SEED=true            # seed the demo workspace when the database is empty
# OPENAI_API_KEY=           # optional: enables OpenAI-written (evidence-validated) interpretations
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=          # optional: OpenAI-compatible endpoint

# ---- Frontend (frontend/.env.local or Vercel project settings) -------------------
# Address of the API as seen by the Next.js server. Read at BUILD time (rewrites are baked in).
# BACKEND_URL=https://your-api.up.railway.app
